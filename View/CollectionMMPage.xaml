<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiMobileApps.Model.Entities"
             x:Class="MauiMobileApps.View.CollectionMMPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="10">
        
        <HorizontalStackLayout>
            <Label Text="Movies"
                   TextColor="CadetBlue"
                   FontAttributes="Bold,Italic"
                   FontSize="50"
                   WidthRequest="170" />
        </HorizontalStackLayout>

        <BoxView HeightRequest="2" BackgroundColor="#000"/>
        
        <CollectionView x:Name="ItemsListView"
                        ItemsSource="{Binding MarvelMoviesCollection}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:MarvelMovies">
                    <Grid Padding="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <HorizontalStackLayout>
                            <Label Text="{Binding NameofMovie}"
                                   FontAttributes="Bold"
                                   FontSize="Medium"
                                   HorizontalTextAlignment="Start"
                                   TextColor="Black"/>
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>