<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMobileApps.View.ControlSliderVMPage"
             Title="{Binding Title}">

    <VerticalStackLayout>

        <BoxView x:Name="MyBox" Color="Blue"
                 HeightRequest="25" HorizontalOptions="Fill" />

        <Slider x:Name="MySlider"
                Minimum="0" Maximum="1" Value="1" 
                ThumbColor="Blue" MaximumTrackColor="BlueViolet" MinimumTrackColor="DarkOrange"
                HorizontalOptions="Fill"
                ValueChanged="OnSliderValueChange" />

        <Label x:Name="ValueLabel"
                   FontAttributes="Bold" FontSize="Large" HorizontalOptions="Center" />

        <Label x:Name="InfoLabel"
               Text="Moving the slider will change opacity"
               FontAttributes="Bold" FontSize="Medium" TextColor="Blue"
               HorizontalOptions="Center" />

        <Button Text="Set Slider to 50%"
                Command="{Binding SetToHalfCommand}"
                Style="{StaticResource TitleButton}"/>

    </VerticalStackLayout>
</ContentPage>