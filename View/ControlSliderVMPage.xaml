<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMobileApps.View.ControlSliderVMPage"
             Title="{Binding Title}">

    <VerticalStackLayout>

        <BoxView Color="{Binding BoxColor}" Opacity="{Binding SliderValue}"
                 HeightRequest="25" HorizontalOptions="Fill" />

        <Slider Minimum="0"
                Maximum="1"
                Value="{Binding SliderValue}"
                ThumbColor="{Binding ThumbColor}"
                MaximumTrackColor="BlueViolet"
                MinimumTrackColor="DarkOrange"
                HorizontalOptions="Fill" />

        <Label Text="{Binding SliderValue, StringFormat='Value of the slider is {0:F2}'}"
               FontAttributes="Bold"
               FontSize="Large"
               HorizontalOptions="Center" />

        <Label Text="{Binding ValueText}"
               FontAttributes="Bold" 
               FontSize="Medium"
               TextColor="Blue" 
               HorizontalOptions="Center" />

        <Button Text="Set Slider to 50%"
                Command="{Binding SetToHalfCommand}"
                BackgroundColor="Blue"
                TextColor="White"
                HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>