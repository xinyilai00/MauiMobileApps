<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMobileApps.View.LayoutFlexPage"
             Title="{Binding Title}">

    <FlexLayout Direction="Row"
                JustifyContent="SpaceAround"
                AlignItems="Center">

        <VerticalStackLayout>
            <BoxView Color= "Red"
                     WidthRequest="60"
                     HeightRequest="60"
                     Margin="5,0"/>

            <Label Text="Red"
                   Margin="5,0"/>
            
        </VerticalStackLayout>

        <VerticalStackLayout>
            <BoxView Color ="Green"
                     WidthRequest ="60"
                     HeightRequest ="60"
                     Margin="5,0"/>

            <Label Text="Green"
                   Margin="5,0"/>
            
        </VerticalStackLayout>

        <VerticalStackLayout>
            <BoxView Color="Blue"
                     WidthRequest="60"
                     HeightRequest="60"
                     Margin="5,0"/>

            <Label Text="Blue"
                   Margin="5,0"/>
            
        </VerticalStackLayout>

    </FlexLayout>
</ContentPage>