<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiMobileApps.Model.Entities"
             x:Class="MauiMobileApps.View.CollectionGOGwImagesPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="20" Spacing="10">

        <CollectionView x:Name="ItemsListView"
                ItemsSource="{Binding GOGActorsCollection}"
                SelectionMode="Single">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:GOGActors">
                    <Grid Padding="2">
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition  Width="Auto"/>
                            <ColumnDefinition  Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Text="{Binding NameofActor}"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               FontSize="Medium"
                               HorizontalTextAlignment="Center"
                               TextColor="CadetBlue"/>

                        <Label Text="{Binding NameofChar}"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontAttributes="Bold, Italic"
                               FontSize="Medium"
                               HorizontalTextAlignment="Center"
                               TextColor="Blue"/>

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <BoxView HeightRequest="1" BackgroundColor="Grey"/>

    </VerticalStackLayout>
</ContentPage>