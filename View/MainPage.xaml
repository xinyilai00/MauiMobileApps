<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMobileApps.View.MainPage"
             Title="{Binding Title}"
             SemanticProperties.Description ="Main Page">

    <VerticalStackLayout Padding="24,16"
                         Spacing="24">
        <Grid RowSpacing="20"
              ColumnSpacing="20"
              Padding="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Text="{Binding Layouts}"
                    Command="{Binding OnLayoutsClick}"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource TitleButton}"
                    SemanticProperties.Description ="Layout"/>
            <Button Text="{Binding Images}"
                    Command="{Binding OnImagesClick}"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource TitleButton}"
                    SemanticProperties.Description ="Images"/>
            <Button Text="{Binding Collections}"
                    Command="{Binding OnCollectionsClick}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource TitleButton}"
                    SemanticProperties.Description ="Collections"/>
            <Button Text="{Binding Controls}"
                    Command="{Binding OnControlsClick}"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource TitleButton}"
                    SemanticProperties.Description ="Controls"/>
            <Button Text="{Binding SQL}"
                    Command="{Binding OnSQLClick}"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource TitleButton}"
                    SemanticProperties.Description ="SQL Lite"/>
        </Grid>

    </VerticalStackLayout>
    
</ContentPage>