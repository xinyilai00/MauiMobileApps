<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiMobileApps.View.MainPage"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="24,16"
                         Spacing="24">
        <Grid RowSpacing="20"
              ColumnSpacing="20"
              Padding="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Text="{Binding Layouts}"
                    Command="{Binding LayoutsClickedCommand}"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource TitleButton}"/>
            
            <Button Text="{Binding Images}"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource TitleButton}"/>
            
            <Button Text="{Binding Collections}"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource TitleButton}"/>
            
            <Button Text="{Binding Controls}"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource TitleButton}"/>
            
            <Button Text="{Binding SQLLite}"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource TitleButton}"/>
        </Grid>

    </VerticalStackLayout>
    
</ContentPage>